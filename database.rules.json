{
  "rules": {
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'phone'])"
      }
    },
    "settings": {
      ".read": true,
      "depositPerGuest": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
      },
      "tablesActive": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "locks": {
      ".read": true,
      "$date": {
        "$table": {
          "$unit": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
            ".validate": "!newData.exists() || newData.child('uid').val() === auth.uid"
          }
        }
      }
    },
    "reservations": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    }
  }
}
